{
  "name": "Aayatun Counter",
  "short_name": "Counter",
  "description": "A simple daily dhikr counter with history and a focus mode.",
  "theme_color": "#0f1b33",
  "background_color": "#0f1b33",
  "icons": [
    {
      "src": "/static/images/icon-64.png",
      "type": "image/png",
      "sizes": "64x64",
      "purpose": "any maskable"
    },
    {
      "src": "/static/images/icon-96.png",
      "type": "image/png",
      "sizes": "96x96",
      "purpose": "any maskable"
    },
    {
      "src": "/static/images/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/static/images/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "id": "/daily-counter",
  "start_url": "/daily-counter",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "any",
  "scope": "/",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  }
}
