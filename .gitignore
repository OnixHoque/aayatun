__pycache__/

# runtime caches (built on demand)
db/qcf_cache.db
db/tajweed_cache.db
db/fonts/

# session signing key (generated on first run)
db/.secret_key

# generated search index + typo vocabulary (rebuilt by build_search.py)
db/search.db
db/search_vocab.pkl
db/*-journal
db/*-wal
db/*-shm
db/translation_vectors.npz
/.venv/
/dist/
/deployment/verification/
evaluation/.cache/

# Optional offline build kit, downloaded separately.
/models/
/deployment/wheels/
